# Materialize only selected sections and resolve placeholders from verified inputs.
# Skills are discovered from .agents/skills without a config entry.

[mcp_servers.example]
enabled = false
command = "{{MCP_COMMAND}}"
args = ["{{MCP_ARGUMENT}}"]

[agents."{{ROLE_NAME}}"]
description = "{{ROLE_DESCRIPTION}}"
config_file = "{{ROLE_NAME}}.toml"
